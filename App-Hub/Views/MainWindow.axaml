<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:AppHub.ViewModels"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        x:Class="AppHub.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="App Hub"
        Width="900" Height="600" MinWidth="560" MinHeight="360">

    <DockPanel Margin="16">

        <!-- Toolbar: Suche, Sortierung, Hinzufügen -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,12">
            <TextBox Grid.Column="0"
                     Text="{Binding SearchText}"
                     PlaceholderText="Suchen …" />
            <ComboBox Grid.Column="1" Margin="8,0" MinWidth="180"
                      ItemsSource="{Binding SortOptions}"
                      SelectedItem="{Binding SelectedSortOption}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SortOption">
                        <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
             <Button Grid.Column="2" Classes="accent"
                    Content="+ Programm hinzufügen"
                    Command="{Binding AddAppCommand}" />
        </Grid>

        <!-- Statuszeile für Fehler und Hinweise -->
        <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0"
                   Foreground="OrangeRed" TextWrapping="Wrap"
                   Text="{Binding StatusMessage}"
                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <Panel>
            <TextBlock Text="Noch keine Programme. Füge eins über „+ Programm hinzufügen“ hinzu."
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Opacity="0.6"
                       IsVisible="{Binding IsEmpty}" />

            <ListBox x:Name="AppList"
                     ItemsSource="{Binding Apps}"
                     IsVisible="{Binding !IsEmpty}"
                     DoubleTapped="AppList_OnDoubleTapped">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:AppEntryViewModel">
                        <Grid ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="{Binding Path}">
                            <Image Grid.Column="0" Width="32" Height="32" Margin="0,0,12,0"
                                   Source="{Binding Icon}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="12" Opacity="0.65"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                        VerticalAlignment="Center">
                                <Button Content="Starten"
                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LaunchCommand}"
                                        CommandParameter="{Binding}" />
                                <Button Content="Pfad ändern"
                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ChangePathCommand}"
                                        CommandParameter="{Binding}" />
                                <Button Content="Entfernen"
                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveCommand}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Panel>
    </DockPanel>
</Window>
