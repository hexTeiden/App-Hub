<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:AppHub.ViewModels"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
        x:Class="AppHub.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="App Hub"
        Icon="/Assets/AppHub.ico"
        Width="1000" Height="650" MinWidth="700" MinHeight="400"
        DragDrop.AllowDrop="True"
        Classes.relaxed="{Binding IsRelaxed}"
        FontFamily="{Binding CurrentFontFamily}">

    <Window.Styles>
        <!-- Relaxed-Theme: dunkler Hintergrund wie in einer Spielebibliothek -->
        <Style Selector="Window.relaxed">
            <Setter Property="RequestedThemeVariant" Value="Dark" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#1F2A38" />
                    <GradientStop Offset="1" Color="#14181F" />
                </LinearGradientBrush>
            </Setter>
        </Style>

        <!-- Relaxed: Kachel-Raster -->
        <Style Selector="ListBox.grid">
            <Setter Property="Background" Value="#661B2028" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8" />
        </Style>
        <Style Selector="ListBox.grid ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="10" />
        </Style>
        <!-- Standard-Hover/Auswahl-Hintergrund von Fluent ausblenden, die Kachel zeigt das selbst -->
        <Style Selector="ListBox.grid ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Border.tile">
            <Setter Property="Width" Value="150" />
            <Setter Property="Height" Value="225" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BoxShadow" Value="0 4 12 0 #80000000" />
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <!-- Durchsichtige Kacheln: Schatten weg, sonst scheint er dunkel durch -->
        <Style Selector="Border.tile.seeThrough">
            <Setter Property="BoxShadow" Value="0 0 0 0 Transparent" />
        </Style>
        <!-- Eigener Hintergrund-Layer, damit nur er durchsichtig wird und nicht Icon/Text -->
        <Style Selector="Border.tileBackground">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#3B4758" />
                    <GradientStop Offset="1" Color="#161B22" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="ListBox.grid ListBoxItem:pointerover Border.tile">
            <Setter Property="RenderTransform" Value="scale(1.04)" />
        </Style>
        <Style Selector="ListBox.grid ListBoxItem:selected Border.tile">
            <Setter Property="BorderBrush" Value="#66C0F4" />
        </Style>

        <!-- Aktionen erscheinen erst beim Drüberfahren -->
        <Style Selector="Border.tileActions">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ListBox.grid ListBoxItem:pointerover Border.tileActions">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Border.tileActions Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="4,4" />
        </Style>

        <Style Selector="Button.tileStar">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="#99000000" />
            <Setter Property="Foreground" Value="#FFD54F" />
            <Setter Property="FontSize" Value="15" />
        </Style>

        <!-- Seitenleiste: Löschen-Button nur beim Drüberfahren zeigen -->
        <Style Selector="ListBox.groups ListBoxItem Button.deleteGroup">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="ListBox.groups ListBoxItem:pointerover Button.deleteGroup">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="ListBox.groups">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Window.Styles>

    <Panel>
        <!-- Eigenes Hintergrundbild (aus den Settings) -->
        <Image Source="{Binding BackgroundImage}"
               Stretch="UniformToFill" Opacity="0.35"
               IsVisible="{Binding HasBackgroundImage}" />

        <DockPanel Margin="16">

            <!-- Toolbar: Suche, Sortierung, Theme, Settings, Hinzufügen -->
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="0,0,0,12">
                <TextBox Grid.Column="0"
                         Text="{Binding SearchText}"
                         PlaceholderText="Searching …" />
                <ComboBox Grid.Column="1" Margin="8,0,0,0" MinWidth="170"
                          ToolTip.Tip="Sort"
                          ItemsSource="{Binding SortOptions}"
                          SelectedItem="{Binding SelectedSortOption}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SortOption">
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox Grid.Column="2" Margin="8,0,0,0" MinWidth="110"
                          ToolTip.Tip="Theme"
                          ItemsSource="{Binding ThemeOptions}"
                          SelectedItem="{Binding SelectedThemeOption}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ThemeOption">
                            <TextBlock Text="{Binding Label}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="3" Margin="8,0,0,0" Content="⚙ Settings">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel Width="240" Spacing="8">
                                <TextBlock Text="Font" FontWeight="SemiBold" />
                                <ComboBox HorizontalAlignment="Stretch"
                                          ItemsSource="{Binding FontOptions}"
                                          SelectedItem="{Binding SelectedFontOption}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FontOption">
                                            <TextBlock Text="{Binding Label}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <TextBlock Text="Background image" FontWeight="SemiBold" Margin="0,8,0,0" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Choose …" Command="{Binding ChangeBackgroundCommand}" />
                                    <Button Content="Remove" Command="{Binding ResetBackgroundCommand}"
                                            IsEnabled="{Binding HasBackgroundImage}" />
                                </StackPanel>

                                <TextBlock Text="{Binding TileTransparencyLabel}" FontWeight="SemiBold" Margin="0,8,0,0" />
                                <Slider Minimum="0" Maximum="100"
                                        TickFrequency="5" IsSnapToTickEnabled="True"
                                        Value="{Binding TileTransparency}"
                                        IsEnabled="{Binding IsRelaxed}" />
                                <TextBlock Text="Only in the Relaxed theme."
                                           FontSize="12" Opacity="0.6"
                                           IsVisible="{Binding !IsRelaxed}" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button Grid.Column="4" Margin="8,0,0,0" Classes="accent"
                        Content="+ Add Program"
                        Command="{Binding AddAppCommand}" />
            </Grid>

            <!-- Statuszeile für Fehler und Hinweise -->
            <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0"
                       Foreground="OrangeRed" TextWrapping="Wrap"
                       Text="{Binding StatusMessage}"
                       IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <!-- Seitenleiste: Gruppen -->
            <DockPanel DockPanel.Dock="Left" Width="190" Margin="0,0,12,0">
                <TextBlock DockPanel.Dock="Top" Text="Groups" FontWeight="SemiBold"
                           Margin="12,4,0,6" Opacity="0.8" />
                <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                    <TextBox Grid.Column="0" PlaceholderText="New group …"
                             Text="{Binding NewGroupName}">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding CreateGroupCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                    <Button Grid.Column="1" Margin="6,0,0,0" Content="+"
                            ToolTip.Tip="Create group"
                            Command="{Binding CreateGroupCommand}" />
                </Grid>
                <ListBox Classes="groups"
                         ItemsSource="{Binding Groups}"
                         SelectedItem="{Binding SelectedGroup}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:GroupViewModel">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="1" Classes="deleteGroup"
                                        Content="✕" Padding="6,0" FontSize="11"
                                        Background="Transparent"
                                        ToolTip.Tip="Delete group"
                                        IsVisible="{Binding CanDelete}"
                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteGroupCommand}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <Panel>
                <TextBlock Text="Noch keine Programme. Füge eins über „+ Add Program“ hinzu."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Opacity="0.6"
                           IsVisible="{Binding IsEmpty}" />
                <TextBlock Text="Nothing to show here."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Opacity="0.6"
                           IsVisible="{Binding IsFilteredEmpty}" />

                <Panel IsVisible="{Binding !IsEmpty}">

                <!-- Relaxed: Kacheln -->
                <ListBox x:Name="AppGrid" Classes="grid"
                         ItemsSource="{Binding Apps}"
                         IsVisible="{Binding IsRelaxed}"
                         DoubleTapped="AppList_OnDoubleTapped">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:AppEntryViewModel">
                            <Border Classes="tile" ToolTip.Tip="{Binding Path}"
                                    Classes.seeThrough="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).HasTransparentTiles}">
                                <Panel>
                                    <Border Classes="tileBackground"
                                            Opacity="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).TileBackgroundOpacity}" />

                                    <!-- Eigenes Bild füllt die ganze Kachel wie ein Cover -->
                                    <Image Source="{Binding CustomImage}" Stretch="UniformToFill"
                                           IsVisible="{Binding HasCustomImage}" />

                                    <Grid RowDefinitions="*,Auto" IsVisible="{Binding !HasCustomImage}">
                                        <Image Width="72" Height="72"
                                               Source="{Binding Icon}"
                                               RenderOptions.BitmapInterpolationMode="HighQuality" />
                                        <TextBlock Grid.Row="1" Margin="10,0,10,14"
                                                   Text="{Binding Name}"
                                                   Foreground="White" FontWeight="SemiBold"
                                                   TextAlignment="Center" TextWrapping="Wrap"
                                                   MaxLines="2" TextTrimming="CharacterEllipsis" />
                                    </Grid>

                                    <TextBlock Text="⚠" Margin="8,6" FontSize="16"
                                               Foreground="OrangeRed"
                                               HorizontalAlignment="Left" VerticalAlignment="Top"
                                               IsVisible="{Binding PathMissing}"
                                               ToolTip.Tip="Path not found!" />

                                    <Border Classes="tileActions" Background="#B0000000">
                                        <StackPanel VerticalAlignment="Center" Margin="12,0" Spacing="6">
                                            <TextBlock Text="{Binding Name}" Foreground="White"
                                                       FontWeight="SemiBold" TextAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" Margin="0,0,0,4" />
                                            <Button Content="Start" Classes="accent"
                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LaunchCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Grid ColumnDefinitions="*,6,*" RowDefinitions="Auto,6,Auto">
                                                <Button Grid.Row="0" Grid.Column="0" Content="Path"
                                                        ToolTip.Tip="Change path"
                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ChangePathCommand}"
                                                        CommandParameter="{Binding}" />
                                                <Button Grid.Row="0" Grid.Column="2" Content="Image"
                                                        ToolTip.Tip="Change image"
                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ChangeImageCommand}"
                                                        CommandParameter="{Binding}" />
                                                <Button Grid.Row="2" Grid.Column="0" Content="Groups">
                                                    <Button.Flyout>
                                                        <Flyout>
                                                            <StackPanel MinWidth="160">
                                                                <TextBlock Text="Create a group in the sidebar first."
                                                                           Opacity="0.7"
                                                                           IsVisible="{Binding !HasGroups}" />
                                                                <ItemsControl ItemsSource="{Binding Memberships}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="vm:GroupMembershipViewModel">
                                                                            <CheckBox Content="{Binding Name}"
                                                                                      IsChecked="{Binding IsMember}" />
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </Flyout>
                                                    </Button.Flyout>
                                                </Button>
                                                <Button Grid.Row="2" Grid.Column="2" Content="Remove"
                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveCommand}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                            <Button Content="Reset image"
                                                    IsVisible="{Binding HasCustomImage}"
                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ResetImageCommand}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Border>

                                    <Button Classes="tileStar" Margin="6"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Content="{Binding FavoriteIcon}"
                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ToggleFavoriteCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="Favorite" />
                                </Panel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Dense: kompakte Liste -->
                <ListBox x:Name="AppList"
                         ItemsSource="{Binding Apps}"
                         IsVisible="{Binding !IsRelaxed}"
                         DoubleTapped="AppList_OnDoubleTapped">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:AppEntryViewModel">
                            <Grid ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="{Binding Path}">
                                <Image Grid.Column="0" Width="32" Height="32" Margin="0,0,12,0"
                                       Source="{Binding DisplayIcon}"
                                       RenderOptions.BitmapInterpolationMode="HighQuality" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="12" Opacity="0.65"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                            VerticalAlignment="Center">
                                    <Button Content="{Binding FavoriteIcon}"
                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ToggleFavoriteCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="Favorite"
                                            FontSize="16"
                                            Classes="appButtons" />
                                    <Button Content="Start"
                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).LaunchCommand}"
                                            CommandParameter="{Binding}"
                                            Classes="appButtons" />
                                    <Button Content="Groups" Classes="appButtons">
                                        <Button.Flyout>
                                            <Flyout>
                                                <StackPanel MinWidth="160">
                                                    <TextBlock Text="Create a group in the sidebar first."
                                                               Opacity="0.7"
                                                               IsVisible="{Binding !HasGroups}" />
                                                    <ItemsControl ItemsSource="{Binding Memberships}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:GroupMembershipViewModel">
                                                                <CheckBox Content="{Binding Name}"
                                                                          IsChecked="{Binding IsMember}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Flyout>
                                        </Button.Flyout>
                                    </Button>
                                    <Button Content="Image"
                                            ToolTip.Tip="Change image"
                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ChangeImageCommand}"
                                            CommandParameter="{Binding}"
                                            Classes="appButtons" />
                                    <Button Content="Reset image"
                                            IsVisible="{Binding HasCustomImage}"
                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ResetImageCommand}"
                                            CommandParameter="{Binding}"
                                            Classes="appButtons" />
                                    <Button Content="Change path"
                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ChangePathCommand}"
                                            CommandParameter="{Binding}"
                                            Classes="appButtons" />
                                    <Button Content="Remove"
                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveCommand}"
                                            CommandParameter="{Binding}"
                                            Classes="appButtons" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                </Panel>
            </Panel>
        </DockPanel>

        <!-- Wird beim Reinziehen von Dateien eingeblendet (siehe MainWindow.axaml.cs) -->
        <Border x:Name="DropOverlay" IsVisible="False"
                DragDrop.AllowDrop="True"
                Background="#C0101418" Margin="8" CornerRadius="8"
                BorderBrush="#66C0F4" BorderThickness="2">
            <TextBlock Text="Drop programs here to add them" IsHitTestVisible="False"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="20" FontWeight="SemiBold" Foreground="White" />
        </Border>
    </Panel>
</Window>
