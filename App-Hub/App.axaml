<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AppHub.App"
             RequestedThemeVariant="Default">
             <!-- "Default" folgt dem System-Theme. Später: eigene Themes über AppSettings.Theme -->

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>
